{
  "name": "requestindexing.com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "license": "MIT",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply request-indexin-bw2z --remote",
    "db:migrate:local": "wrangler d1 migrations apply request-indexin-bw2z --local",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=16384}\" nuxt build",
    "dev": "nuxt dev",
    "dev:link": "bash scripts/dev-link.sh",
    "tokens": "bun ./scripts/env.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate": "nuxt generate",
    "preview": "wrangler dev --cwd .output",
    "deploy": "node --experimental-strip-types scripts/deploy-cloudflare.ts",
    "postinstall": "nuxt prepare",
    "release": "bumpp",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "checkin": "nuxt-checkin prepare && nuxt-checkin --save"
  },
